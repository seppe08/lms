# Application
PROJECT_NAME=LMS API
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Database (PostgreSQL with asyncpg)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lms_db
# URL-encode special characters in database credentials (for example, @ becomes %40).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lms_db

# Security & JWT (generate strong random values for production, e.g. `openssl rand -hex 32`)
SECRET_KEY=change-me-to-a-strong-random-secret-key-min-32-chars
JWT_SECRET_KEY=change-me-to-a-strong-random-jwt-secret-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (JSON array of allowed origins)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Rate limiting (auth endpoints)
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Optional observability (Sentry is disabled when SENTRY_DSN is empty)
SENTRY_DSN=
# Fraction of traces sent to Sentry: 0.0 disables new traces, 1.0 captures all.
SENTRY_TRACES_SAMPLE_RATE=0.1
# Forward standard-library logging records to Sentry Logs.
SENTRY_CAPTURE_LOGS=true